{
  "name": "replace-in-file",
  "type": "module",
  "version": "9.0.0",
  "description": "A simple utility to quickly replace text in one or more files.",
  "homepage": "https://github.com/adamreisnz/replace-in-file#readme",
  "author": {
    "name": "Adam Reis",
    "email": "adam@reis.nz"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/adamreisnz/replace-in-file.git"
  },
  "bugs": {
    "url": "https://github.com/adamreisnz/replace-in-file/issues"
  },
  "keywords": [
    "replace",
    "text",
    "contents",
    "file"
  ],
  "packageManager": "pnpm@11.18.0",
  "main": "./dist/index.js",
  "bin": "./dist/bin/cli.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "test": "mocha --node-option=experimental-strip-types 'src/**/*.spec.ts'",
    "lint": "eslint .",
    "coverage": "c8 npm run test",
    "coverage:ci": "c8 npm run test",
    "postcoverage": "open -a \"Google Chrome\" ./coverage/lcov-report/index.html",
    "prepack": "pnpm run build",
    "postversion": "git push && git push --tags"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "chalk": "^6.0.0",
    "glob": "^13.0.6",
    "yargs": "^18.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/chai": "^5.2.3",
    "@types/chai-as-promised": "^8.0.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.1.2",
    "@types/yargs": "^17.0.35",
    "c8": "^12.0.0",
    "chai": "^6.2.2",
    "chai-as-promised": "^8.0.2",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "mocha": "^11.7.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  }
}
