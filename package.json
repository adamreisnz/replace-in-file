{
  "name": "replace-in-file",
  "type": "module",
  "version": "9.0.0",
  "description": "A simple utility to quickly replace text in one or more files.",
  "homepage": "https://github.com/adamreisnz/replace-in-file#readme",
  "author": {
    "name": "Adam Reis",
    "email": "adam@reis.nz"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/adamreisnz/replace-in-file.git"
  },
  "bugs": {
    "url": "https://github.com/adamreisnz/replace-in-file/issues"
  },
  "keywords": [
    "replace",
    "text",
    "contents",
    "file"
  ],
  "packageManager": "pnpm@11.18.0",
  "main": "index.js",
  "bin": "./bin/cli.js",
  "types": "./types/index.d.ts",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "mocha 'src/**/*.spec.js'",
    "lint": "eslint .",
    "coverage": "c8 npm run test",
    "postcoverage": "open -a \"Google Chrome\" ./coverage/lcov-report/index.html",
    "postversion": "git push && git push --tags && npm publish"
  },
  "files": [
    "bin",
    "src",
    "types",
    "index.js"
  ],
  "dependencies": {
    "chalk": "^6.0.0",
    "glob": "^13.0.6",
    "yargs": "^18.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "c8": "^12.0.0",
    "chai": "^6.2.2",
    "chai-as-promised": "^8.0.2",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "mocha": "^11.7.6"
  }
}
